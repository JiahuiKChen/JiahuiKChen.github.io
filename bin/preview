#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT_DIR"

if [ -x /opt/homebrew/opt/ruby@3.2/bin/ruby ]; then
  export PATH="/opt/homebrew/opt/ruby@3.2/bin:$PATH"
fi

export BUNDLE_GEMFILE="${BUNDLE_GEMFILE:-$ROOT_DIR/Gemfile.local}"
export BUNDLE_PATH="${BUNDLE_PATH:-$ROOT_DIR/vendor/bundle}"

bundle check >/dev/null 2>&1 || bundle install

exec bundle exec jekyll serve --livereload --incremental "$@"
